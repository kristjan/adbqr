#!/usr/bin/env bash
#
# adbqr pairs a laptop to an Android phone over wireless debugging with a QR
# code, so you skip Android Studio and reading an IP and code off the phone.
#
# It shows a QR for Android's "Pair device with QR code" (Developer options >
# Wireless debugging), then finds the phone over mDNS and pairs.
#
# The QR uses Android's adb-pairing format:
#   WIFI:T:ADB;S:<service-name>;P:<pairing-code>;;
# The WIFI: prefix is misleading. S is an mDNS service name rather than an
# SSID, and P is the pairing code rather than a password. It never reads your
# SSID or asks for Location permission.

TIMEOUT=60

die() { echo "Error: $*" >&2; exit 1; }
require() { command -v "$1" >/dev/null 2>&1 || die "'$1' not found. $(install_hint "$1")"; }

# The platform's usual package manager, or nothing if none is recognized.
pkg_manager() {
    if [ "$(uname)" = "Darwin" ]; then echo brew; return; fi
    local m
    for m in apt dnf pacman zypper apk; do
        if command -v "$m" >/dev/null 2>&1; then echo "$m"; return; fi
    done
}

# How to install a missing dependency on this platform. Package names differ
# between distributions, so each pair gets its own line.
install_hint() {
    local mgr
    mgr=$(pkg_manager)
    case "$1:$mgr" in
        adb:brew)                            echo "Install it: brew install --cask android-platform-tools" ;;
        adb:apt)                             echo "Install it: sudo apt install adb" ;;
        adb:dnf|adb:zypper)                  echo "Install it: sudo $mgr install android-tools" ;;
        adb:pacman)                          echo "Install it: sudo pacman -S android-tools" ;;
        adb:apk)                             echo "Install it: sudo apk add android-tools" ;;
        adb:*)                               echo "Install Android platform-tools." ;;
        qrencode:apt|qrencode:dnf|qrencode:zypper) echo "Install it: sudo $mgr install qrencode" ;;
        qrencode:brew)                       echo "Install it: brew install qrencode" ;;
        qrencode:pacman)                     echo "Install it: sudo pacman -S qrencode" ;;
        qrencode:apk)                        echo "Install it: sudo apk add libqrencode-tools" ;;
        qrencode:*)                          echo "Install qrencode." ;;
    esac
}

usage() {
    cat <<'EOF'
Usage: adbqr [--timeout SECONDS]

Show a QR code for Android "Pair device with QR code" (Developer options >
Wireless debugging), then detect the phone over mDNS and pair automatically.

  --timeout SECONDS   How long to wait for the phone (default 60).
  -h, --help          Show this help.
EOF
}

# Best-effort IPv4 prefix length of the default-route interface. Echoes a
# number (e.g. 19) or nothing if it can't be determined.
wifi_prefixlen() {
    local iface mask n p
    if [ "$(uname)" = "Darwin" ]; then
        iface=$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')
        [ -n "$iface" ] || return 0
        mask=$(ifconfig "$iface" 2>/dev/null | awk '/inet /{print $4; exit}')
        case "$mask" in 0x*) ;; *) return 0 ;; esac
        n=$((16#${mask#0x})); p=0
        while [ "$n" -gt 0 ]; do p=$((p + (n & 1))); n=$((n >> 1)); done
        echo "$p"
    else
        iface=$(ip route show default 2>/dev/null | awk '/default/{print $5; exit}')
        [ -n "$iface" ] || return 0
        ip -o -f inet addr show dev "$iface" 2>/dev/null \
            | awk '{print $4}' | awk -F/ 'NF>1 {print $2; exit}'
    fi
}

# Warn up front when the network looks like a large shared pool (guest/public
# Wi-Fi), which commonly blocks the mDNS discovery QR pairing depends on.
network_warning() {
    local plen
    plen=$(wifi_prefixlen)
    [ -n "$plen" ] || return 0
    if [ "$plen" -le 22 ]; then
        echo "Heads up: this looks like a large shared network (/$plen). Public and"
        echo "guest Wi-Fi often block the mDNS that QR pairing relies on; if the"
        echo "phone just spins, that's the likely cause."
        echo ""
    fi
}

# Render the QR as an inline image using iTerm2's image protocol.
render_inline_iterm2() {
    local b64
    b64=$(qrencode -m 2 -s 8 -o - -t PNG "$PAYLOAD" | base64 | tr -d '\n') || return 1
    printf '\033]1337;File=inline=1;preserveAspectRatio=1:%s\a\n' "$b64"
}

# Render the QR as an inline image using the Kitty graphics protocol (Ghostty
# speaks this). The base64 payload is sent in <=4096-byte chunks.
render_inline_kitty() {
    local b64 pos len chunk m first
    b64=$(qrencode -m 2 -s 8 -o - -t PNG "$PAYLOAD" | base64 | tr -d '\n') || return 1
    pos=0; len=${#b64}; first=1
    while [ "$pos" -lt "$len" ]; do
        chunk=${b64:pos:4096}
        pos=$((pos + 4096))
        m=1; if [ "$pos" -ge "$len" ]; then m=0; fi
        if [ "$first" -eq 1 ]; then
            printf '\033_Gf=100,a=T,m=%d;%s\033\\' "$m" "$chunk"
            first=0
        else
            printf '\033_Gm=%d;%s\033\\' "$m" "$chunk"
        fi
    done
    printf '\n'
}

# Ask the terminal a capability question. Writes $1 to the tty, then a DA1
# request (CSI c) which every terminal answers. That guarantees the read
# terminates quickly even when the queried capability is unsupported. Echoes
# the raw response. Requires an interactive tty.
term_query() {
    [ -t 1 ] && [ -r /dev/tty ] || return 1
    local old resp
    old=$(stty -g </dev/tty 2>/dev/null) || return 1
    stty -echo -icanon </dev/tty 2>/dev/null || { stty "$old" </dev/tty 2>/dev/null; return 1; }
    printf '%s\033[c' "$1" >/dev/tty
    IFS= read -rs -t 1 -d c resp </dev/tty || true
    stty "$old" </dev/tty 2>/dev/null
    printf '%s' "$resp"
}

# True if the terminal supports the Kitty graphics protocol (Ghostty, kitty,
# WezTerm, Konsole, ...). Sends a 1x1 query image; a supporting terminal
# replies with "_Gi=31;OK" before the DA1 response.
supports_kitty_graphics() {
    local r
    r=$(term_query $'\033_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\033\\') || return 1
    [[ "$r" == *"_Gi=31;OK"* ]]
}

# True if the terminal supports the iTerm2 inline-image protocol. iTerm2 and
# WezTerm identify themselves in their XTVERSION (CSI > q) reply.
supports_iterm2_image() {
    local r
    r=$(term_query $'\033[>q') || return 1
    [[ "$r" == *"iTerm2"* || "$r" == *"WezTerm"* ]]
}

# Pick the best rendering by querying the terminal's actual capabilities,
# falling back to a Unicode block QR (ANSIUTF8 forces black-on-white so
# polarity survives any theme). Terminals without an image protocol (e.g.
# macOS Terminal) and non-tty output use the block fallback.
render_qr() {
    if supports_kitty_graphics && render_inline_kitty; then return; fi
    if supports_iterm2_image && render_inline_iterm2; then return; fi
    qrencode -m 2 -t ANSIUTF8 "$PAYLOAD"
}

main() {
    set -euo pipefail

    while [ $# -gt 0 ]; do
        case "$1" in
            --timeout) shift; TIMEOUT="${1:-}" ;;
            -h|--help) usage; return 0 ;;
            *) usage >&2; return 2 ;;
        esac
        shift
    done

    require adb
    require qrencode

    NAME="adbqr-$(printf '%04x%04x' "$RANDOM" "$RANDOM")"
    CODE=$(( (RANDOM * 32768 + RANDOM) % 900000 + 100000 ))
    PAYLOAD="WIFI:T:ADB;S:$NAME;P:$CODE;;"

    echo "On the phone: Developer options > Wireless debugging > Pair device with QR code"
    echo "Service: $NAME"
    echo "Code:    $CODE"
    echo ""

    render_qr

    echo ""
    network_warning
    echo "Waiting up to ${TIMEOUT}s for the phone over mDNS (Ctrl-C to abort)..."

    local ADDR="" nudged=0 i
    for i in $(seq 1 "$TIMEOUT"); do
        ADDR=$(adb mdns services 2>/dev/null \
            | awk '/_adb-tls-pairing\._tcp/ {print $3; exit}')
        [ -n "$ADDR" ] && break
        if [ "$nudged" -eq 0 ] && [ "$i" -ge 15 ]; then
            nudged=1
            echo ""
            echo "Still waiting. If you've already scanned, this network may be"
            echo "blocking mDNS device discovery (common on public/guest Wi-Fi)."
            echo "There's no on-network fix. Pair over a phone hotspot or USB"
            echo "(adb tcpip) instead."
            echo ""
        fi
        sleep 1
    done

    [ -n "$ADDR" ] || die "No pairing service appeared within ${TIMEOUT}s. Make sure the phone scanned the QR and is on the same network."

    echo "Pairing with $ADDR ..."
    exec adb pair "$ADDR" "$CODE"
}

# Only run the pairing flow when executed directly; sourcing (e.g. from tests)
# loads the functions without running main.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
